import React, { useState } from 'react';
import { Text, View, Button, StyleSheet, Modal, ScrollView, TouchableOpacity, TextInput, Alert } from 'react-native';

export default function App() {
  // Lista inicial de receitas para o App não começar totalmente vazio
  const [receitas, setReceitas] = useState([
    {
      id: '1',
      nome: 'Bolo de Cenoura',
      ingredientes: '• 3 cenouras médias\n• 4 ovos\n• 1 xícara de óleo\n• 2 xícaras de açúcar\n• 2 xícaras de farinha\n• 1 colher de fermento',
      preparo: 'Bata no liquidificador as cenouras, os ovos e o óleo. Misture o açúcar e a farinha em uma tigela, adicione o líquido e por último o fermento. Asse por 40 minutos.'
    }
  ]);

  // Estados para controle de visibilidade dos Modals
  const [verReceitaVisivel, setVerReceitaVisivel] = useState(false);
  const [cadastroVisivel, setCadastroVisivel] = useState(false);

  // Estado para guardar a receita selecionada que o usuário quer ler
  const [receitaSelecionada, setReceitaSelecionada] = useState(null);

  // Estados dos campos do formulário de cadastro (Requisito 4)
  const [nomeInput, setNomeInput] = useState('');
  const [ingredientesInput, setIngredientesInput] = useState('');
  const [preparoInput, setPreparoInput] = useState('');

  // Função para abrir os detalhes de uma receita específica
  const lidarVerReceita = (receita) => {
    setReceitaSelecionada(receita);
    setVerReceitaVisivel(true);
  };

  // Função para validar e salvar a nova receita (Requisito 4)
  const salvarReceita = () => {
    if (!nomeInput.trim() || !ingredientesInput.trim() || !preparoInput.trim()) {
      Alert.alert('Erro', 'Por favor, preencha todos os campos!');
      return;
    }

    const novaReceita = {
      id: Math.random().toString(),
      nome: nomeInput,
      ingredientes: ingredientesInput,
      preparo: preparoInput,
    };

    setReceitas([...receitas, novaReceita]);
    Alert.alert('Sucesso', 'Receita salva com sucesso!');
    limparFormulario();
  };

  // Função para o botão cancelar e limpar os campos (Requisito 4)
  const cancelarCadastro = () => {
    limparFormulario();
  };

  const limparFormulario = () => {
    setNomeInput('');
    setIngredientesInput('');
    setPreparoInput('');
    setCadastroVisivel(false);
  };

  return (
    <View style={styles.container}>
      
      {/* TELA INICIAL COM SCROLLVIEW (Requisito 4) */}
      <ScrollView contentContainerStyle={styles.mainScroll}>
        <Text style={styles.title}>📱 App de Receitas</Text>
        <Text style={styles.subtitle}>Colecione suas receitas preferidas</Text>

        {/* Renderização dinâmica dos cartões de receitas */}
        {receitas.map((item) => (
          <View key={item.id} style={styles.card}>
            <Text style={styles.cardTitle}>🍴 {item.nome}</Text>
            <Button 
              title="Ver Receita" 
              color="#e65100" 
              onPress={() => lidarVerReceita(item)} 
            />
          </View>
        ))}
      </ScrollView>

      {/* REQUISITO 2: Modal de Visualização de Detalhes */}
      <Modal
        animationType="slide"
        transparent={false}
        visible={verReceitaVisivel}
        onRequestClose={() => setVerReceitaVisivel(false)}
      >
        {receitaSelecionada && (
          <ScrollView contentContainerStyle={styles.recipeContainer}>
            <Text style={styles.recipeTitle}>📖 {receitaSelecionada.nome}</Text>
            
            <Text style={styles.sectionTitle}>Ingredientes</Text>
            <Text style={styles.recipeText}>{receitaSelecionada.ingredientes}</Text>

            <Text style={styles.sectionTitle}>Modo de Preparo</Text>
            <Text style={styles.recipeText}>{receitaSelecionada.preparo}</Text>
            
            <TouchableOpacity style={styles.btnFechar} onPress={() => setVerReceitaVisivel(false)}>
              <Text style={styles.btnButtonText}>Fechar Visualização</Text>
            </TouchableOpacity>
          </ScrollView>
        )}
      </Modal>

      {/* REQUISITO 3: Botão Flutuante (FAB) */}
      <TouchableOpacity style={styles.fab} onPress={() => setCadastroVisivel(true)}>
        <Text style={styles.fabText}>+</Text>
      </TouchableOpacity>

      {/* REQUISITO 4: Modal de Cadastro de Novas Receitas */}
      <Modal
        animationType="fade"
        transparent={true}
        visible={cadastroVisivel}
        onRequestClose={cancelarCadastro}
      >
        <View style={styles.modalOverlay}>
          <View style={styles.modalFormBox}>
            <Text style={styles.modalFormTitle}>Nova Receita</Text>

            {/* Inputs de Texto */}
            <TextInput
              style={styles.input}
              placeholder="Nome da receita"
              placeholderTextColor="#999"
              value={nomeInput}
              onChangeText={setNomeInput}
            />

            <TextInput
              style={[styles.input, styles.inputMultiline]}
              placeholder="Ingredientes (um por linha)"
              placeholderTextColor="#999"
              multiline={true}
              numberOfLines={4}
              value={ingredientesInput}
              onChangeText={setIngredientesInput}
            />

            <TextInput
              style={[styles.input, styles.inputMultiline]}
              placeholder="Modo de preparo"
              placeholderTextColor="#999"
              multiline={true}
              numberOfLines={4}
              value={preparoInput}
              onChangeText={setPreparoInput}
            />

            {/* Botões do Formulário */}
            <View style={styles.formActionGroup}>
              <TouchableOpacity style={[styles.formBtn, styles.btnCancel]} onPress={cancelarCadastro}>
                <Text style={styles.btnButtonText}>Cancelar</Text>
              </TouchableOpacity>

              <TouchableOpacity style={[styles.formBtn, styles.btnSave]} onPress={salvarReceita}>
                <Text style={styles.btnButtonText}>Salvar</Text>
              </TouchableOpacity>
            </View>
          </View>
        </View>
      </Modal>

    </View>
  );
}

